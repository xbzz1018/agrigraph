# AgriGraph Python 农业病虫害多模态知识服务配置。
# 所有 Python 命令由脚本固定在 Conda AiJava 环境执行。

AGRIGRAPH_PORT=8188
AGRIGRAPH_DB_PATH=var/agrigraph.db
AGRIGRAPH_CHECKPOINT_DB_PATH=var/langgraph-checkpoints.db
AGRIGRAPH_AUTH_REQUIRED=true
AGRIGRAPH_BOOTSTRAP_ADMIN_USERNAME=admin
AGRIGRAPH_BOOTSTRAP_ADMIN_PASSWORD=
AGRIGRAPH_DATA_ROOT=./data/public

# 推荐优先使用这一套通用网关配置
PAISMART_JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
PAISMART_ADMIN_USERNAME=admin
PAISMART_ADMIN_PASSWORD=
AGRIGRAPH_ES_INDEX=agrigraph_evidence_v2
GATEWAY_API_BASE=
GATEWAY_API_KEY=
GATEWAY_MODEL=provider-text-model
# 仅用于运行审计中的成本估算，单位为 USD / 1M tokens；请按供应商实际价格填写。
AGRIGRAPH_GATEWAY_INPUT_COST_PER_MILLION=0
AGRIGRAPH_GATEWAY_OUTPUT_COST_PER_MILLION=0
NEO4J_URI=bolt://127.0.0.1:27687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# 如果你不想继承 GATEWAY_*，也可以直接单独覆盖
DEEPSEEK_API_BASE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=provider-text-model

# OpenAI 兼容远程视觉模型；未配置时图片入口显示未配置。
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=provider-vision-model
VISION_TIMEOUT=120

# 可选 BGE 服务。端点为空时保留 BM25 顺序并禁用长期语义记忆。
AGRIGRAPH_EMBEDDING_API_BASE=
AGRIGRAPH_EMBEDDING_API_KEY=
AGRIGRAPH_EMBEDDING_MODEL=BAAI/bge-m3
AGRIGRAPH_EMBEDDING_DIMENSIONS=1024
AGRIGRAPH_EMBEDDING_TIMEOUT_SECONDS=30
AGRIGRAPH_RERANKER_API_BASE=
AGRIGRAPH_RERANKER_API_KEY=
AGRIGRAPH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AGRIGRAPH_RERANKER_TIMEOUT_SECONDS=30
AGRIGRAPH_RERANKER_CANDIDATE_LIMIT=30

# 分层记忆。连接串由本地 infra.env 注入，未配置时继续使用 SQLite 会话上下文。
AGRIGRAPH_REDIS_URL=
AGRIGRAPH_SHORT_MEMORY_TTL_SECONDS=86400
AGRIGRAPH_SHORT_MEMORY_LIMIT=12
AGRIGRAPH_POSTGRES_DSN=
AGRIGRAPH_MEMORY_PROJECT_SCOPE=agrigraph
AGRIGRAPH_MEMORY_INDEX=agrigraph_memory_v1
AGRIGRAPH_MEMORY_TTL_DAYS=365

# 本地开发时的日志和性能调优参数
PAISMART_SHOW_SQL=false
PAISMART_LOG_SPRING_WEB=INFO
PAISMART_LOG_SPRING_SECURITY=WARN
PAISMART_LOG_APP=INFO
PAISMART_LOG_APP_SERVICE=INFO
PAISMART_LOG_HIBERNATE_SQL=WARN
